{
  "name": "construacero-staging",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npx concurrently -n VITE,API -c cyan,yellow \"vite\" \"npm run dev:worker\"",
    "dev:vite": "vite",
    "dev:api": "npm run dev:worker",
    "dev:worker": "npx wrangler dev --config wrangler.toml --port 8789 --local --env-file .dev.vars",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --config vitest.config.js",
    "test:watch": "vitest --config vitest.config.js",
    "test:e2e:staging": "node scripts/test-e2e-staging.mjs",
    "test:e2e:consumo-credito": "node scripts/test-consumo-credito-staging.mjs",
    "audit:kardex:staging": "node scripts/audit-kardex-staging.mjs",
    "verify:p0:staging": "node scripts/verify-p0-financial-staging.mjs",
    "monitor:kardex:staging": "node scripts/monitor-kardex-staging.mjs",
    "plan:reconcile:kardex:staging": "node scripts/reconcile-kardex-staging.mjs",
    "report:kardex:dry-run": "node scripts/render-kardex-dry-run.mjs",
    "correlate:kardex:staging": "node scripts/correlate-kardex-readonly.mjs",
    "evaluate:medium-confidence": "node scripts/evaluate-medium-confidence.mjs",
    "reconcile:high-confidence": "node scripts/apply-high-confidence-reconciliation.mjs",
    "provision:e2e:staging": "node scripts/provision-staging-e2e.mjs",
    "configure:local": "node configure-local-worker.js",
    "check": "npm test && npm run build",
    "check:all": "npm run check && npm --prefix nomina-construacero test && npm --prefix nomina-construacero run build"
  },
  "dependencies": {
    "@honcho-ai/sdk": "^2.1.1",
    "@supabase/supabase-js": "^2.97.0",
    "@tanstack/react-query": "^5.80.2",
    "@tanstack/react-query-persist-client": "^5.99.2",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.2.2",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.575.0",
    "pg": "^8.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.14.1",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.8.1",
    "vite-plugin-pwa": "^1.2.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.17",
    "vite": "^7.2.4",
    "vitest": "^4.1.5",
    "wrangler": "^4.87.0"
  }
}
