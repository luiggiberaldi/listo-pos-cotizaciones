subir_cambios.bat
deploy_ahora.bat

# Ignorar archivos de pruebas y reportes que pueden tener data sensible (JWTs, hashes)
*.json
!package.json
!package-lock.json
!manifest.webmanifest
!wrangler.jsonc
!vercel.json
!eslint.config.json

# Ignorar archivos de script temporales y tests específicos
*.cjs
*.mjs
scratch*
*.test.js
*.test.jsx
__tests__/
*.md
!README.md
!ARQUITECTURA.md
!ROADMAP.md
!BITACORA.md
