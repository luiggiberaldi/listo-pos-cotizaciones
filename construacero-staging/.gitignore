# Automatización E2E segura: estos dos scripts sí deben viajar con staging.
!scripts/
scripts/*
!scripts/test-e2e-staging.mjs
!scripts/provision-staging-e2e.mjs
!scripts/audit-kardex-staging.mjs
!scripts/reconcile-kardex-staging.mjs
!scripts/monitor-kardex-staging.mjs
!scripts/test-consumo-credito-staging.mjs
!scripts/detect-double-credit-cxc-staging.mjs

# Keep the regression test that protects the nightly E2E guards.
