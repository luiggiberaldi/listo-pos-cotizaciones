# Credenciales EXCLUSIVAS para npm run test:e2e:staging
# Esta cuenta debe existir en Supabase STAGING y no debe usarse en producción.
STAGING_E2E_EMAIL=supervisor-e2e@listo.sys
STAGING_E2E_PASSWORD=REEMPLAZAR_CON_PASSWORD_LOCAL

# Opcional: el runner lee DEV_SUPER_CODE desde .dev.vars.
# Si no se usa el desarrollador virtual, configure ambos valores:
# STAGING_E2E_OPERATOR_ID=UUID_DEL_OPERADOR_STAGING
# STAGING_E2E_PIN=PIN_LOCAL_DE_STAGING

# Las siguientes guardas tienen valores fijos y no deben cambiarse a producción:
# STAGING_E2E_FRONTEND_ORIGIN=http://localhost:5174
# STAGING_E2E_WORKER_ORIGIN=http://127.0.0.1:8789
