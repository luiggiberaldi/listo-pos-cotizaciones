{
  "name": "listo-pos-cotizaciones",
  "main": "./worker.js",
  "compatibility_date": "2024-12-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vars": {
    "SUPABASE_URL": "https://oyfyuszgjwcepjpngclv.supabase.co"
  }
  // Configure SUPABASE_ANON_KEY, SUPABASE_SERVICE_KEY, and DEV_SUPER_CODE
  // through Cloudflare secrets or protected environment bindings.
}
